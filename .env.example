# Copy this file to ".env" and change the values:
#     cp .env.example .env
# Never commit your real ".env" file to Git.

# ---------- Database connection ----------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=student_ms
DB_USER=student_user
DB_PASSWORD=change_this_password

# ---------- Needed in production (Docker) ----------
# Create a random value with:   openssl rand -hex 64
SECRET_KEY_BASE=change_this_to_a_long_random_secret
